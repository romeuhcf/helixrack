#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "rack"
require "helix_rack"

# PRD.md section 6.2's CLI flags (-a/-p/-b from Phase 2, --keep-alive-timeout/
# --max-keepalive from Phase 4, --cpu-time-slice from Phase 6, --grace-period
# from Phase 8).
options = {
  app: "config.ru",
  port: 8080,
  bind: "0.0.0.0",
  keep_alive_timeout: 15,
  max_keepalive: 10_000,
  cpu_time_slice_ms: 5,
  grace_period_seconds: 30
}

# rubocop:disable Metrics/BlockLength -- one `parser.on` clause per PRD.md
# section 6.2 CLI flag; this grows by design as later phases add flags
# (matching how Phase 4's --keep-alive-timeout/--max-keepalive and now
# Phase 6's --cpu-time-slice were each added here), not something to split
# up for a line-count target.
OptionParser.new do |parser|
  parser.banner = "Usage: helix_rack [options]"
  parser.on("-a", "--app PATH", "Path to the Rackup / Grape app (default: config.ru)") do |v|
    options[:app] = v
  end
  parser.on("-p", "--port PORT", Integer, "TCP port to listen on (default: 8080)") do |v|
    options[:port] = v
  end
  parser.on("-b", "--bind HOST", "Network interface IP to bind to (default: 0.0.0.0)") do |v|
    options[:bind] = v
  end
  parser.on(
    "--keep-alive-timeout SECONDS", Integer,
    "Timeout in seconds for closing idle connections (default: 15)"
  ) do |v|
    options[:keep_alive_timeout] = v
  end
  parser.on(
    "--max-keepalive N", Integer,
    "Maximum requests per TCP connection before forced close (default: 10000)"
  ) do |v|
    options[:max_keepalive] = v
  end
  parser.on(
    "--cpu-time-slice MS", Integer,
    "Continuous CPU time (ms) a handler may run before a preemption signal fires (default: 5)"
  ) do |v|
    options[:cpu_time_slice_ms] = v
  end
  parser.on(
    "--grace-period SECONDS", Integer,
    "How long to wait for active requests to finish after SIGTERM/SIGINT (default: 30)"
  ) do |v|
    options[:grace_period_seconds] = v
  end
end.parse!(ARGV)
# rubocop:enable Metrics/BlockLength

app = Rack::Builder.parse_file(options[:app])
HelixRack.serve(
  app, options[:port],
  bind: options[:bind],
  keep_alive_timeout: options[:keep_alive_timeout],
  max_keepalive: options[:max_keepalive],
  cpu_time_slice_ms: options[:cpu_time_slice_ms],
  grace_period_seconds: options[:grace_period_seconds]
)
